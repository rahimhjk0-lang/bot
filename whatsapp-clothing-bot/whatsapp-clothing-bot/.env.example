# ==== اختيار محرك الذكاء الاصطناعي ====
# القيمة: gemini  أو  claude
AI_PROVIDER=gemini

# مفتاح Gemini (مجاني) - احصل عليه من https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# مفتاح Claude (اختياري، إذا حبيت تبدل من Gemini لـ Claude) - من https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ==== إعدادات المتجر ====
STORE_NAME=المتجر
# رقم/أرقام الأدمين (بصيغة دولية بلا +، مثال جزائر: 213XXXXXXXXX) مفصولين بفاصلة
ADMIN_NUMBERS=213000000000
# سعر السيري ما ينقصش تحت هذا الهامش بالنسبة المئوية عند التفاوض (احتياطي عام، كل سلعة عندها سعرها الأدنى الخاص فاللوحة)
DEFAULT_MIN_DISCOUNT_PERCENT=5

# ==== لوحة التحكم ====
ADMIN_PASSWORD=غير_هذا_الرمز
PORT=3000
